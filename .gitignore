# All build artefacts live out-of-source under build/<preset>/, so almost
# everything we want to ignore is rooted there.

/build/

# clangd compile-commands symlink at repo root
/compile_commands.json

# editor / IDE
/.vscode/
/.idea/
/.cursor/
/.cache/

# vim / emacs swap files
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# local Conan cache, if someone happens to run it in-tree
/.conan2/
