[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=22
compiler.cppstd=23
compiler.libcxx=libstdc++11
build_type=Debug

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
# Conan recipes report Linux system packages they need (xcb, fontenc, ...).
# Override to 'install' if you want Conan to run pacman/apt with sudo.
tools.system.package_manager:mode=report
